{
  "name": "tcw-dqm",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.10.4",
    "@mui/icons-material": "^5.10.9",
    "@mui/material": "^5.10.13",
    "@okta/okta-auth-js": "^7.14.1",
    "@okta/okta-react": "^6.10.0",
    "@testing-library/jest-dom": "^5.15.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.0.2",
    "@types/node": "^16.11.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.3.0",
    "axios": "^0.24.0",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-sonarjs": "^0.10.0",
    "prettier": "^2.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-error-boundary": "^3.1.4",
    "react-router": "^6.0.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "^4.0.3",
    "tss-react": "^4.4.1",
    "type-fest": "^0.18.1",
    "typescript": "^4.4.4",
    "validator": "^13.7.0",
    "web-vitals": "^2.1.2"
  },
  "scripts": {
    "start": "env-cmd -f .env.local react-scripts --openssl-legacy-provider start",
    "start:sandbox": "env-cmd .env.sandbox react-scripts --openssl-legacy-provider start",
    "start:dev": "env-cmd -f .env.development react-scripts --openssl-legacy-provider start",
    "start:qa": "env-cmd -f .env.qa react-scripts start",
    "start:prod": "env-cmd -f .env.production react-scripts --openssl-legacy-provider start",
    "build": "env-cmd -f .env.local react-scripts --openssl-legacy-provider build",
    "build:sandbox": "BUILD_PATH='./build-sandbox' env-cmd -f .env.sandbox react-scripts --openssl-legacy-provider build",
    "build:development": "BUILD_PATH='./build-dev' env-cmd -f .env.development react-scripts --openssl-legacy-provider build",
    "build:qa": "BUILD_PATH='./build-qa' env-cmd -f .env.qa react-scripts --openssl-legacy-provider build",
    "build:production": "BUILD_PATH='./build-prod' env-cmd -f .env.production react-scripts --openssl-legacy-provider build",
    "version": "node -p require('./package.json').version",
    "lint": "eslint --ext .ts --ext .tsx . --max-warnings=0",
    "test": "react-scripts test a --watchAll=false --coverage  --passWithNoTests",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-router-dom": "^5.3.2",
    "@types/validator": "^13.6.6",
    "@typescript-eslint/parser": "^5.3.0",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jest-dom": "^3.9.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-testing-library": "^5.0.0",
    "sass": "~1.77.8"
  }
}
