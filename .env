REACT_APP_VERSION=$npm_package_version
REACT_APP_NAME=$npm_package_name
REACT_APP_ENABLE_SWAGGER=true
REACT_APP_EXCEPTION_LIMIT=5000
# STANDALONE_APP controls how the operator identity is resolved for
# calls that need a DM_USER.USER (SP_GET_DM_ROLE, SP_GET_RULE_GROUPS_
# FOR_USER, SP_UPDATE_USER_PREFERENCES, ...):
#   true  — hardcode "Joann Banks" (default for the tcw-dqm repo).
#   false — read the injected value from <CurrentUserProvider>, which
#           TIME-Next populates with the Okta-resolved display name.
# VITE_STANDALONE_APP mirrors the CRA-prefixed var so the same env
# file works for Vite-hosted builds (TIME-Next).
REACT_APP_STANDALONE_APP=true
VITE_STANDALONE_APP=true

# Silence Dart Sass's "legacy JS API is deprecated" warning that
# sass-loader v10 (bundled with react-scripts 4) prints on every
# start/build. sass-loader 10 still calls the legacy render() API
# because CRA never bumped it; upgrading sass-loader would need
# webpack 5 which requires ejecting CRA. This env var is Sass's
# officially-supported knob (added in Dart Sass 1.72) for the
# exact "I can't upgrade my sass-loader yet" scenario. Remove when
# we migrate off react-scripts.
SASS_SILENCE_DEPRECATIONS=legacy-js-api
